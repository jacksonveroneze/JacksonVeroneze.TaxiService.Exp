{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Literate, Serilog.Sinks.Console",
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj} {Properties:j}{NewLine}{Exception}{NewLine}"
              }
            },
            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://10.0.0.199:5341"
              }
            }
          ]
        }
      }
    ]
  },
  "Cache": {
    "Type": "Redis",
    "Endpoint": "10.0.0.199:6379"
  },
  "Database": {
    "ReadConnectionString": "Host=10.0.0.150;Port=6432;Database=taxiservice;Username=postgres;Password=localP@ssword;Maximum Pool Size=200;Minimum Pool Size=10;Timeout=10;Command Timeout=20"
  }
}
