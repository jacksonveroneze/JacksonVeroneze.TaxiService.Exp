{
  "Application": {
    "Name": "JacksonVeroneze.TaxiService.Exp",
    "Description": "API for: TaxiService.Exp",
    "Version": "1.0.0"
  },
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/health' or RequestPath like '/metrics-open'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/favicon%' or RequestPath like '/swagger%' or RequestPath like '/index.html'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore.Mvc": "Information",
        "Microsoft.AspNetCore.Mvc.Internal": "Information",
        "Microsoft.AspNetCore.Authentication": "Information",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Information",
        "Microsoft.AspNetCore.Http.Result.JsonResult": "Information",
        "Microsoft.AspNetCore.Mvc.Infrastructure.ControllerActionInvoker": "Information",
        "Microsoft.AspNetCore.Http.Result.OkObjectResult": "Warning",
        "CorrelationId.CorrelationIdMiddleware": "Warning"
      }
    }
  },
  "HttpClients": [
    {
      "Name": "MercadoPago",
      "Address": "http://10.0.0.199:7075",
      "UsePrometheusHttpMetrics": true,
      "IgnoreCertificateValidation": false,
      "TimeOutPolicy": {
        "TimeOutMs": 5000
      },
      "RetryPolicy": {
        "RetryCount": 3,
        "SleepDurationMs": 100
      },
      "CircuitBreakerPolicy": {
        "EventsAllowedBeforeBreaking": 10,
        "DurationOfBreakMs": 10000
      },
      "ChaosTimeoutPolicy": {
        "IsEnabled": false,
        "InjectionRate": 0.5,
        "LatencyMs": 6000
      },
      "ChaosResultPolicy": {
        "IsEnabled": false,
        "InjectionRate": 0.7,
        "StatusCode": 500
      }
    },
    {
      "Name": "Stripe",
      "Address": "http://10.0.0.199:7075",
      "UsePrometheusHttpMetrics": true,
      "IgnoreCertificateValidation": false,
      "TimeOutPolicy": {
        "TimeOutMs": 5000
      },
      "RetryPolicy": {
        "RetryCount": 3,
        "SleepDurationMs": 100
      },
      "CircuitBreakerPolicy": {
        "EventsAllowedBeforeBreaking": 10,
        "DurationOfBreakMs": 10000
      },
      "ChaosTimeoutPolicy": {
        "IsEnabled": false,
        "InjectionRate": 0.5,
        "LatencyMs": 6000
      },
      "ChaosResultPolicy": {
        "IsEnabled": false,
        "InjectionRate": 0.7,
        "StatusCode": 500
      }
    }
  ]
}
